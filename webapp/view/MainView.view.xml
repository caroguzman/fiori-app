<mvc:View 
    controllerName="trialcaro.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="page" title="{i18n>title}">
        <content>
            <Panel id="PanelText" headerText="{i18n>selectionScreen}">
                <Label id="labelShipName" labelFor="shipName" text="{i18n>shipName}" class="sapUiSmallMargin"/>
                <Input id="shipName" value="{selectionScreen>/ShipName}" width="200px" class="sapUiMarginEnd"/>
                <Label id= "labelCountry" text="{i18n>country}" class="sapUiSmallMargin"/>
                <Select id="slCountry"  selectedKey="{selectionScreen>/CountryKey}" 
                                        forceSelection="false" 
                                        items="{selectionScreen>/Countries}" 
                                        visible="true">
                    <items>
                        <core:Item id="itemid" key="{selectionScreen>key}" text="{selectionScreen>text}"/>
                    </items>
                </Select>
                <Button id="btnFilter"  text="{i18n>btnFilter}" 
                                        icon="sap-icon://filter" 
                                        press="onFilter" 
                                        class="sapUiSmallMarginEnd"/>
                <Button id="btnClearFilter"
                        text="{i18n>btnClearFilters}"
                        icon="sap-icon://clear-filter"
                        press="onClearFilter" 
                        class="sapUiSmallMarginEnd"/>
            </Panel>
            <Panel id="PanelList">
                <List id="invoicesList" headerText="{i18n>invoicesHeaderList}" class="sapUiResponsiveMargin" width="auto" items="{Invoices}">
                    <items>
                        <ObjectListItem id="ObjectListItem" 
                                        title="{ShipName} - {Country}" 
                                        number="{parts : [  {path: 'ExtendedPrice'}, 
                                                            {path: 'selectionScreen>/Currency'}], 
                                                type: 'sap.ui.model.type.Currency',
                                                formatOptions:{
                                                    showMeasure : false
                                                }}"
                                        numberUnit="{selectionScreen>/Currency}"
                                        numberState="{=${ExtendedPrice} > 100 ? 'Success' : 'Warning'}">
                        </ObjectListItem>
                    </items>
                </List>
            </Panel>
        </content>
    </Page>
</mvc:View>